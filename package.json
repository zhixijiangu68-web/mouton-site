{
  "name": "mouton-site",
  "private": true,
  "description": "ムートンの個人サイト。src/ のテンプレートから、リポジトリ直下に HTML を生成する。",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "check": "eleventy && git status --porcelain && test -z \"$(git status --porcelain)\"",
    "test": "npm run test:design && npm run test:tracking && npm run test:waitlist && eleventy && node scripts/check-site.mjs",
    "test:tracking": "node --test tests/campaign-url.test.mjs",
    "x:today": "node scripts/x-today.mjs",
    "test:design": "node --test tests/design-version.test.mjs tests/legacy-navigation.test.mjs",
    "test:waitlist": "node --test tests/waitlist-readiness.test.mjs",
    "lint:writing": "node scripts/lint-writing.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "budoux": "^0.9.3"
  },
  "type": "module"
}
