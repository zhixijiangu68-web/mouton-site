---js
{
  permalink: data => (data.site.url ? "feed.xml" : false),
  eleventyExcludeFromCollections: true,
}
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.name }}</title>
  <link>{{ '' | absoluteUrl(site.url) }}</link>
  <atom:link href="{{ 'feed.xml' | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml"/>
  {#- 2026-10-28 記事の型の段階1：チャンネルの説明は今のサイト（作り直したあとの記事）に合わせた一文。site.description（哲学の PDF のころの説明）は変えていない。
       「出典をすべて載せた」は言いすぎなので（出典の番号のない数字があり、辞書や成分表で判定した行もある）、2026-10-28 の点検で「研究や資料と照らして」「出典つき」に直した。 #}
  <description>食・身体・お金・生き方について、よく言われていることを、研究や資料と照らして一つずつ判定した記事。出典つき。</description>
  <language>ja</language>
  {#- 2026-10-17：RSS に出すのは残す記事だけ（アーカイブの記事は出さない）。 #}
  {%- for a in collections.current | head(20) %}
  <item>
    <title>{{ a.data.headline }}{% if a.data.paid %}（有料・冒頭は無料）{% endif %}</title>
    <link>{{ (a.page.fileSlug + '.html') | absoluteUrl(site.url) }}</link>
    <guid isPermaLink="true">{{ (a.page.fileSlug + '.html') | absoluteUrl(site.url) }}</guid>
    <pubDate>{{ a.page.date | rfc822 }}</pubDate>
    <description>{{ a.data.description }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
