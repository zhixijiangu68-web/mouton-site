{%- if not guide %}{% set gpicks = collections.articles | bySlugs(related or []) %}{% set gp = false %}{% for a in gpicks %}{% if a.data.guide and not gp %}{% set gp = a %}{% endif %}{% endfor %}
{%- if gp %}<aside class="guide-callout" aria-label="関連する選び方"><p class="guide-callout-eyebrow">買う前に</p><a class="guide-callout-link" href="{{ gp.page.fileSlug }}.html"><span class="guide-callout-title">{{ gp.data.guide.title }}</span><span class="guide-callout-text">{{ gp.data.guide.text }}</span><span class="guide-callout-more">選び方を読む <span aria-hidden="true">→</span></span></a></aside>{% endif %}{% endif %}
{%- set picks = collections.articles | relatedTo({ fileSlug: page.fileSlug, topic: topic }, related) %}
{%- set topicInfo = topics | findTopic(topic) %}
<nav class="reading-next" aria-labelledby="reading-next-heading"><h2 id="reading-next-heading">次に読む</h2>
{%- if picks.length %}<div class="reading-next-grid">
{%- for a in picks %}{% if not gp or a.page.fileSlug != gp.page.fileSlug %}<a class="reading-card" href="{{ a.page.fileSlug }}.html">{{ a.data.journal.title if a.data.journal else a.data.headline }}</a>{% endif %}{% endfor %}</div>{% endif %}
<p class="reading-returns"><a class="reading-return" href="{{ back.href }}">{{ back.text }}</a>
{%- if topicInfo %}<a class="reading-return" href="topic-{{ topicInfo.key }}.html">「{{ topicInfo.label }}」の記事をすべて見る</a>{% endif %}</p></nav>
