{%- if health %}
<aside class="article-note" aria-label="ご注意">
  <p class="article-note-title">この記事について</p>
  <p>この記事は、論文や公的な情報をもとにした一般的な情報提供を目的としています。医師による診断や治療の代わりにはなりません。体調に不安があるときや、持病・服薬がある場合は、医療機関に相談してください。</p>
</aside>
{%- endif %}
{%- if category == 'books' and site.affiliate.amazonTag %}
<p class="article-pr">このページには広告（アフィリエイトリンク）が含まれます。リンクから商品が購入されると、当サイトに紹介料が支払われることがあります。</p>
{%- endif %}
{%- if site.ads.adsenseClient and site.ads.adsenseSlot %}
<aside class="ad-slot" aria-label="広告">
  <p class="ad-label">広告</p>
  <ins class="adsbygoogle" style="display:block" data-ad-client="{{ site.ads.adsenseClient }}" data-ad-slot="{{ site.ads.adsenseSlot }}" data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script>(adsbygoogle=window.adsbygoogle||[]).push({});</script>
</aside>
{%- endif %}
{% include "partials/newsletter.njk" %}
<aside class="author-box" aria-labelledby="author-box-name">
  <div class="author-mark" aria-hidden="true">ム</div>
  <div>
    <p class="author-label">この記事を書いた人</p>
    <p class="author-name" id="author-box-name">{{ site.author.name }}</p>
    <p class="author-bio">{{ site.author.bio }}</p>
    <p class="author-links"><a href="operator.html">運営者情報</a><a href="https://x.com/{{ site.author.x }}" target="_blank" rel="noopener noreferrer">X / @{{ site.author.x }} <span aria-hidden="true">↗</span></a></p>
    <p class="author-dates">公開 {{ page.date | dotDate }}{% if updated %}　更新 {{ updated | dotDate }}{% endif %}</p>
  </div>
</aside>
