<script src="home.js" defer></script>
<script src="home-tabs.js" defer></script>
<script>
'use strict';
const articleRoutes={"article-self-image":"self-image.html","article-hill":"hill.html","article-nietzsche":"nietzsche.html","article-trampoline":"trampoline.html","article-stamina":"stamina.html"};
const legacy={now:'top'};
(()=>{const name=location.hash.slice(1);if(articleRoutes[name])location.replace(articleRoutes[name]);else if(legacy[name])history.replaceState(null,'','#'+legacy[name]);})();

// Journal: newest first, category filters, search.
const journalList=document.querySelector('.journal-list');
[...journalList.children].sort((a,b)=>{
 const date=node=>node.querySelector('.journal-date')?.textContent.trim()||'';
 return date(b).localeCompare(date(a));
}).forEach(item=>journalList.appendChild(item));
const items=[...journalList.querySelectorAll('.journal-item')];
const filters=[...document.querySelectorAll('[data-journal-filter]')];
const searchInput=document.getElementById('journal-search-input');
const searchStatus=document.querySelector('.journal-search-status');
const normalize=text=>text.normalize('NFKC').toLowerCase().replace(/\s+/g,'');
const storageKey='mouton-journal-filter-v2';
items.forEach(item=>{item.dataset.search=normalize(item.querySelector('.journal-body').textContent);});
filters.forEach(b=>{const v=b.dataset.journalFilter;const c=document.createElement('span');c.className='count';c.textContent=items.filter(i=>v==='all'||i.dataset.category===v).length;b.appendChild(c);});
let filter='all';
try{const v=sessionStorage.getItem(storageKey);if(filters.some(b=>b.dataset.journalFilter===v))filter=v;}catch{}
// Full-text search: the article text is fetched the first time someone searches.
let fullText=null,loadingText=null;
const loadText=()=>loadingText||(loadingText=fetch('search.json').then(r=>r.ok?r.json():[]).catch(()=>[]).then(d=>{
 fullText=new Map(d.map(e=>[e.url,{...e,norm:normalize(e.text)}]));
 if(searchInput.value)applyFilter(filter);
}));
// Only the newest entries show until the reader asks for the rest.
const COLLAPSED_COUNT=4;
const expandKey='mouton-journal-expanded-v2';
let expanded=false;
try{expanded=sessionStorage.getItem(expandKey)==='1';}catch{}
const more=document.createElement('button');
more.type='button';
more.className='journal-more';
more.setAttribute('aria-controls','journal-list');
journalList.id='journal-list';
more.addEventListener('click',()=>{
 expanded=true;
 try{sessionStorage.setItem(expandKey,'1');}catch{}
 const first=items.find(i=>i.classList.contains('is-collapsed'));
 applyFilter(filter);
 if(first)first.focus({preventScroll:true});
});
const extra=document.createElement('div');
extra.className='journal-extra';
journalList.after(extra);
extra.after(more);
function snippet(entry,raw){
 const text=entry.text,i=text.toLowerCase().indexOf(raw.toLowerCase());
 if(i<0)return null;
 const p=document.createElement('span');
 p.className='journal-snippet';
 const start=Math.max(0,i-36),end=Math.min(text.length,i+raw.length+60);
 const mark=document.createElement('mark');
 mark.textContent=text.slice(i,i+raw.length);
 p.append((start>0?'…':'')+text.slice(start,i),mark,text.slice(i+raw.length,end)+(end<text.length?'…':''));
 return p;
}
function applyFilter(value){
 filter=value;
 try{sessionStorage.setItem(storageKey,filter);}catch{}
 filters.forEach(b=>{const selected=b.dataset.journalFilter===filter;b.classList.toggle('active',selected);b.setAttribute('aria-pressed',String(selected));});
 const raw=searchInput.value.trim();
 const query=normalize(raw);
 let shown=0;
 const listed=new Set();
 items.forEach(item=>{
  const href=item.getAttribute('href');
  if(href)listed.add(href);
  item.querySelector('.journal-snippet')?.remove();
  const entry=href&&fullText?fullText.get(href):null;
  const inList=query===''||item.dataset.search.includes(query);
  const inBody=!inList&&entry&&entry.norm.includes(query);
  const hidden=(filter!=='all'&&item.dataset.category!==filter)||!(inList||inBody);
  item.classList.toggle('is-hidden',hidden);
  item.classList.remove('is-collapsed');
  if(!hidden){shown++;if(inBody){const s=snippet(entry,raw);if(s)item.querySelector('.journal-body').append(s);}}
 });
 // Articles that are not in the journal list (food & science, books) still turn up in a search.
 extra.replaceChildren();
 if(query!==''&&fullText&&filter==='all'){
  for(const entry of fullText.values()){
   if(listed.has(entry.url)||!entry.norm.includes(query))continue;
   const a=document.createElement('a');
   a.className='journal-item clickable journal-link';
   a.href=entry.url;
   const date=document.createElement('div');date.className='journal-date';date.textContent=entry.date;
   const body=document.createElement('div');body.className='journal-body';
   const title=document.createElement('div');title.className='journal-title';title.textContent=entry.title;
   const ex=document.createElement('div');ex.className='journal-excerpt';ex.textContent=entry.excerpt;
   const time=document.createElement('span');time.className='journal-read-time';time.textContent='約'+entry.minutes+'分';
   body.append(title,ex,time);
   const s=snippet(entry,raw);if(s)body.append(s);
   const arrow=document.createElement('div');arrow.className='journal-arrow';arrow.textContent='→';
   a.append(date,body,arrow);
   extra.append(a);shown++;
  }
 }
 // Collapse the full, unfiltered list to its newest entries.
 const browsing=query===''&&filter==='all';
 if(browsing&&!expanded){
  items.filter(i=>!i.classList.contains('is-hidden')).slice(COLLAPSED_COUNT).forEach(i=>i.classList.add('is-collapsed'));
 }
 const rest=items.filter(i=>i.classList.contains('is-collapsed')).length;
 more.hidden=rest===0;
 more.textContent='すべての記事を見る（あと'+rest+'件）';
 searchStatus.textContent=query===''?'':shown?shown+'件の記事が見つかりました'+(fullText?'（本文も検索しています）':''):'該当する記事はありませんでした';
}
filters.forEach(b=>b.addEventListener('click',()=>applyFilter(b.dataset.journalFilter)));
searchInput.addEventListener('input',()=>{loadText();applyFilter(filter);});
searchInput.addEventListener('focus',loadText,{once:true});
document.querySelectorAll('[data-filter-link]').forEach(a=>a.addEventListener('click',()=>{searchInput.value='';applyFilter(a.dataset.filterLink);}));
applyFilter(filter);

</script>
