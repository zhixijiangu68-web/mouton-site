{#- 毎回ホームを開いた時の演出を維持する。タブや記事へのディープリンクは邪魔しない。 #}
<script>try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&(!location.hash||location.hash==='#top'))document.documentElement.classList.add('intro','intro-preparing');setTimeout(()=>{const d=document.documentElement;if(d.classList.contains('intro-preparing')){d.classList.add('intro-fallback-font');d.classList.remove('intro-preparing')}},1200);}catch(e){}</script>
<div class="intro-veil" aria-hidden="true">
  <p class="intro-word">{%- for c in "MOUTON" %}<span style="--i:{{ loop.index0 }}">{{ c }}</span>{% endfor %}</p>
  <p class="intro-sub">A personal archive — since 2026</p>
  <span class="intro-bar"></span>
</div>
<a class="skip" href="#top">本文へスキップ</a>
{% include "partials/nav.njk" %}

<main>
  {#- 表紙。通常デザインに統一。 #}
  <section class="cover cover-choice" id="top" data-nav="dark" data-nav-solid="dark">
    <div class="cover-art" aria-hidden="true"><i class="cover-light l1"></i><i class="cover-light l2"></i><i class="cover-light l3"></i></div>
    <div class="hero-light" aria-hidden="true"></div>
    <p class="hero-word" aria-hidden="true"><span>MOUTON</span><span>MOUTON</span></p>
    <div class="cover-inner">
      <p class="cover-kicker">MOUTON / PERSONAL ARCHIVE</p>
      {#- 見出しは画面に出さない（読み上げ・検索用に h1 だけ残す） #}
      <h1 class="cover-title cover-title--choice visually-hidden">ムートン — 哲学と科学で、日常の見え方を変える</h1>
      <nav class="cover-choice-grid" aria-label="3つのテーマから読む">
        <a class="cover-choice-card cover-choice-card--think" id="think" href="topic-philosophy.html">
          <span class="cover-choice-art" aria-hidden="true"></span>
          <span class="cover-choice-content">
            <span class="cover-choice-number">01 / Philosophy</span>
            <strong class="cover-choice-title">考える。</strong>
            <span class="cover-choice-description">哲学・生き方・自分との向き合い方</span>
            <span class="cover-choice-action">記事を見る <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <a class="cover-choice-card cover-choice-card--body" id="body" href="topic-body.html">
          <span class="cover-choice-art" aria-hidden="true"></span>
          <span class="cover-choice-content">
            <span class="cover-choice-number">02 / Body</span>
            <strong class="cover-choice-title">身体で、確かめる。</strong>
            <span class="cover-choice-description">睡眠・体力・外見・身体のこと</span>
            <span class="cover-choice-action">記事を見る <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <a class="cover-choice-card cover-choice-card--food" id="food" href="topic-food.html">
          <span class="cover-choice-art" aria-hidden="true"></span>
          <span class="cover-choice-content">
            <span class="cover-choice-number" id="foodscience">03 / Food &amp; Science</span>
            <strong class="cover-choice-title">食べることを、科学で。</strong>
            <span class="cover-choice-description">食べ物・栄養・成分のエビデンス</span>
            <span class="cover-choice-action">記事を見る <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </nav>
      <p class="cover-links cover-links--choice">
        <a href="journal.html">記事を探す <span aria-hidden="true">→</span></a>
        <a href="quiz.html">○×クイズ <span aria-hidden="true">→</span></a>
        <a href="start.html">はじめての方へ <span aria-hidden="true">→</span></a>
        <a href="en/index.html" hreflang="en" lang="en">English <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <div class="hero-ticker" aria-label="最近の記事">
      <span class="hero-ticker-label">Now reading</span>
      <div class="hero-ticker-track">
        {%- for copy in [0, 1] %}
        <ul class="hero-ticker-list"{% if copy %} aria-hidden="true"{% endif %}>
          {%- for a in collections.articles | head(12) %}
          <li><a href="{{ a.page.fileSlug }}.html"{% if copy %} tabindex="-1"{% endif %}>{{ a.data.guide.title if a.data.guide else (a.data.journal.title if a.data.journal else a.data.headline) }}</a></li>
          {%- endfor %}
