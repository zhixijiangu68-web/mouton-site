      <div class="foodscience-grid">
        {%- for a in collections.articles | scienceCards %}
        <a class="science-card" data-rise href="{{ a.page.fileSlug }}.html"><span class="science-tag">{{ a.data.science.tag }}</span><h3>{{ a.data.science.title }}</h3><p>{{ a.data.science.text }}</p><span class="science-more">約{{ a.data.readMinutes }}分で読む →</span></a>
        {%- endfor %}
